# ── Production (docker compose) ─────────────────────────────────────────────
DOMAIN=control.viscosity.one
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48 — encrypts stored provider keys and MFA secrets. Back it up; losing it makes them unrecoverable.
VISCOSITY_SECRET_KEY=
# Optional: the URL workers dial if it differs from https://$DOMAIN (e.g. a Tailscale MagicDNS name with its own TLS).
WORKER_URL=

# ── Local development (pnpm dev) — uncomment and remove the block above ─────
# DATABASE_URL=postgres://viscosity:viscosity@127.0.0.1:5432/viscosity
# VISCOSITY_SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# PUBLIC_ORIGIN=http://localhost:3000
# WORKER_URL=http://localhost:4000
# PORT=4000
