# Control-plane API + the worker bundle it hands out to servers being enrolled.
FROM node:22-bookworm-slim AS build
RUN corepack enable && apt-get update && apt-get install -y --no-install-recommends python3 build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json ./
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
RUN pnpm install --frozen-lockfile --filter @viscosity/api... --filter @viscosity/worker...
RUN pnpm --filter @viscosity/api build && pnpm --filter @viscosity/worker build \
 && mkdir -p /out && tar -czf /out/worker.tgz -C apps/worker dist \
 && pnpm --filter @viscosity/api deploy --prod --legacy /out/api

FROM node:22-bookworm-slim
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4000 DATA_DIR=/data WORKER_BUNDLE=/app/worker.tgz MIGRATIONS_DIR=/app/drizzle TRUST_PROXY=true
WORKDIR /app
COPY --from=build /out/api/node_modules ./node_modules
COPY --from=build /repo/apps/api/dist ./dist
COPY --from=build /repo/apps/api/drizzle ./drizzle
COPY --from=build /out/worker.tgz ./worker.tgz
COPY deploy/install-worker.sh ./install-worker.sh
RUN mkdir -p /data && chown node:node /data
USER node
VOLUME /data
EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD node -e "fetch('http://127.0.0.1:4000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/index.mjs"]
